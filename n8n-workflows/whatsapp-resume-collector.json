{
  "name": "Hagerstone — WhatsApp Resume Collector (Maytapi)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "maytapi-resume",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "maytapi-webhook",
      "name": "Maytapi Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "maytapi-resume",
      "notes": "Set this webhook URL in Maytapi Dashboard → Settings → Webhook URL.\nURL will be: https://primary-production-72e3f.up.railway.app/webhook/maytapi-resume"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "has-document",
              "leftValue": "={{ $json.body.data.type }}",
              "rightValue": "document",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-document",
      "name": "Filter — Document Messages Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 380]
    },
    {
      "parameters": {
        "jsCode": "// Extract sender info from Maytapi webhook payload\nconst data = $input.item.json.body?.data || {};\nconst from = data.from || '';\n\n// WhatsApp number is like 919876543210@c.us — strip the @c.us\nconst phone = from.replace('@c.us', '').replace('@s.whatsapp.net', '');\n// Name from pushname or fallback to phone\nconst senderName = data.pushname || data.notifyName || `WA-${phone.slice(-4)}`;\nconst msgBody = data.text?.body || data.caption || '';\nconst msgId = data.id || '';\nconst documentData = data.message?.document || {};\nconst mediaId = documentData.id || msgId;\nconst mimeType = documentData.mimetype || 'application/pdf';\nconst filename = documentData.filename || `resume_${phone}.pdf`;\n\nreturn {\n  json: {\n    phone,\n    full_name: senderName,\n    email: `${phone}@whatsapp.noemail`,\n    msg_body: msgBody,\n    msg_id: msgId,\n    media_id: mediaId,\n    mime_type: mimeType,\n    filename\n  }\n};"
      },
      "id": "extract-wa-sender",
      "name": "Extract WhatsApp Sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 380]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.maytapi.com/api/{{ 'b8cce1b9-0f9f-4aef-994c-d232716471f0' }}/{{ '46821' }}/getMedia",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "message_id", "value": "={{ $json.msg_id }}" },
            { "name": "type", "value": "document" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-maytapi-key", "value": "ebfd5e67-6403-4921-b300-a54364f2c470" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-media",
      "name": "Maytapi — Download Resume File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 380]
    },
