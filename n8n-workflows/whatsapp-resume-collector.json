        "url": "=https://sgerslbmnwrltqrhsdir.supabase.co/storage/v1/object/resumes/whatsapp/{{ $('Extract WhatsApp Sender').item.json.phone }}_{{ $now.toFormat('yyyyMMdd_HHmmss') }}.pdf",
