      "id": "get-latest-job-wa",
      "name": "Supabase — Get Latest Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 380]
    },
    {
      "parameters": {
        "jsCode": "const sender = $('Extract WhatsApp Sender').item.json;\nconst storagePath = $('Supabase Storage — Upload Resume').item.json?.Key || null;\nconst jobs = $input.item.json;\nconst job = Array.isArray(jobs) ? jobs[0] : jobs;\n\nreturn {\n  json: {\n    job_id: job?.id || null,\n    full_name: sender.full_name,\n    email: sender.email,\n    phone: sender.phone || null,\n    portal: 'whatsapp',\n    stage: 'new',\n    resume_path: storagePath,\n    screening_notes: `Via WhatsApp — ${sender.msg_body?.slice(0,200) || ''}`,\n    applied_at: new Date().toISOString()\n  }\n};"
      },
