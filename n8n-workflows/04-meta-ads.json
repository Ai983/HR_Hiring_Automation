{
  "name": "Hagerstone — Job Posting Meta Ads",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-posted",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-job-posted",
      "name": "Supabase — Job Posted Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "job-posted-meta",
      "notes": "Configure in Supabase → Database → Webhooks → Table: jobs → Event: INSERT or UPDATE"
    },
    {
      "parameters": {
        "jsCode": "// Extract job data and check if social posting is needed\nconst body = $input.item.json.body || $input.item.json;\nconst record = body.record || body;\nconst portalStatus = record.portal_status || {};\n\nconst fbLive = portalStatus.facebook?.status === 'live';\nconst igLive = portalStatus.instagram?.status === 'live';\n\nif (!fbLive && !igLive) return [];\n\n// Build a short post caption (max 500 chars for FB, 2200 for IG)\nconst jd = (record.jd || record.description || '').slice(0, 400);\nconst caption = `🏢 We're Hiring at Hagerstone!\\n\\n📌 Role: ${record.title}\\n\\n${jd}\\n\\n📧 Apply: careers@hagerstone.com\\n🌐 hagerstone.com`;\n\nreturn [{\n  json: {\n    job_id: record.id,\n    title: record.title,\n    caption: caption,\n    post_to_facebook: fbLive,\n    post_to_instagram: igLive\n  }\n}];"
      },
      "id": "check-social-portals",
      "name": "Check Social Portals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "fb-live",
              "leftValue": "={{ $json.post_to_facebook }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-facebook",
      "name": "Filter — Facebook Live",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "ig-live",
              "leftValue": "={{ $json.post_to_instagram }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-instagram",
      "name": "Filter — Instagram Live",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [720, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v18.0/' + $env.FACEBOOK_PAGE_ID + '/feed' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.FACEBOOK_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.caption }) }}",
        "options": {}
      },
      "id": "post-facebook",
      "name": "Meta — Post to Facebook Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "notes": "⚠️ Set FACEBOOK_PAGE_ID and FACEBOOK_PAGE_ACCESS_TOKEN in n8n Settings → Variables"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v18.0/' + $env.INSTAGRAM_BUSINESS_ACCOUNT_ID + '/media' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.FACEBOOK_PAGE_ACCESS_TOKEN }}" },
            { "name": "caption", "value": "={{ $json.caption }}" },
            { "name": "media_type", "value": "IMAGE" },
            { "name": "image_url", "value": "={{ $env.HAGERSTONE_LOGO_URL }}" }
          ]
        },
        "options": {}
      },
      "id": "ig-create-media",
      "name": "Meta — Create Instagram Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 400],
      "notes": "⚠️ Set INSTAGRAM_BUSINESS_ACCOUNT_ID and HAGERSTONE_LOGO_URL in n8n Variables"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v18.0/' + $env.INSTAGRAM_BUSINESS_ACCOUNT_ID + '/media_publish' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.FACEBOOK_PAGE_ACCESS_TOKEN }}" },
            { "name": "creation_id", "value": "={{ $json.id }}" }
          ]
        },
        "options": {}
      },
      "id": "ig-publish",
      "name": "Meta — Publish Instagram Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Supabase — Job Posted Webhook": {
      "main": [[{ "node": "Check Social Portals", "type": "main", "index": 0 }]]
    },
    "Check Social Portals": {
      "main": [
        [{ "node": "Filter — Facebook Live", "type": "main", "index": 0 }],
        [{ "node": "Filter — Instagram Live", "type": "main", "index": 0 }]
      ]
    },
    "Filter — Facebook Live": {
      "main": [[{ "node": "Meta — Post to Facebook Page", "type": "main", "index": 0 }]]
    },
    "Filter — Instagram Live": {
      "main": [[{ "node": "Meta — Create Instagram Media Container", "type": "main", "index": 0 }]]
    },
    "Meta — Create Instagram Media Container": {
      "main": [[{ "node": "Meta — Publish Instagram Post", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "id": "meta-ads-v1",
  "tags": [{ "name": "hagerstone" }, { "name": "job-posting" }, { "name": "awaiting-credentials" }]
}
