      "id": "fetch-doc-pending",
      "name": "Supabase — Fetch Joiners with Pending Docs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Send individual reminders to each joiner AND a summary to HR\nconst data = $input.item.json;\nconst joinings = Array.isArray(data) ? data : [data];\n\nif (!joinings.length || !joinings[0]?.id) return [];\n\n// Build one item per joiner for the WhatsApp send node\nconst items = joinings.map(j => {\n  const name = j.applicants?.full_name || 'New Joiner';\n  const phone = j.applicants?.phone || '';\n  const normalised = phone.replace(/^\\+?91/, '').replace(/\\D/g, '');\n  const joiningDate = j.joining_date || 'your joining date';\n  return {\n    candidate_name: name,\n    to_number: normalised.length === 10 ? '91' + normalised : null,\n    message: `Hi ${name}, your joining date at Hagerstone is ${joiningDate}. 📄 Please submit all required documents at the earliest to ensure a smooth onboarding. Contact HR at careers@hagerstone.com if you need help. Thank you!`\n  };\n}).filter(i => i.to_number);\n\nreturn items.map(i => ({ json: i }));"
      },
      "id": "format-doc-reminders",
      "name": "Format Doc Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.maytapi.com/api/b8cce1b9-0f9f-4aef-994c-d232716471f0/46821/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-maytapi-key", "value": "ebfd5e67-6403-4921-b300-a54364f2c470" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to_number: $json.to_number, type: 'text', message: $json.message }) }}",
        "options": {}
      },
      "id": "whatsapp-doc-reminder",
      "name": "Maytapi — Send Doc Reminder to Joiner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300]
    }
