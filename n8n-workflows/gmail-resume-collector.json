    {
      "parameters": {
        "jsCode": "// Merge sender details + job_id for the applicant insert\nconst sender = $('Extract Sender Details').item.json;\nconst jobs = $input.item.json;\nconst job = Array.isArray(jobs) ? jobs[0] : jobs;\n\nreturn {\n  json: {\n    job_id: job?.id || null,\n    full_name: sender.full_name,\n    email: sender.email,\n    phone: sender.phone || null,\n    portal: 'email',\n    stage: 'new',\n    resume_text: sender.body_snippet,\n    screening_notes: `Via email — Subject: ${sender.subject}`,\n    applied_at: new Date().toISOString()\n  }\n};"
      },
