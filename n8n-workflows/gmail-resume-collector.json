    {
      "parameters": {
        "jsCode": "// Extract sender name + email from Gmail message\nconst from = $input.item.json.from || '';\nconst subject = $input.item.json.subject || '';\nconst body = $input.item.json.text || $input.item.json.snippet || '';\n\n// Parse \"Name <email>\" format\nconst emailMatch = from.match(/<(.+?)>/);\nconst nameMatch = from.match(/^(.+?)</);\n\nconst senderEmail = emailMatch ? emailMatch[1].trim() : from.trim();\nconst senderName = nameMatch ? nameMatch[1].trim().replace(/\"/g,'') : senderEmail.split('@')[0];\n\n// Try to guess phone from email body\nconst phoneMatch = body.match(/(?:\\+?91[\\s-]?)?[6-9]\\d{9}/);\nconst phone = phoneMatch ? phoneMatch[0].replace(/[\\s-]/g,'') : '';\n\nreturn {\n  json: {\n    full_name: senderName,\n    email: senderEmail,\n    phone: phone,\n    subject: subject,\n    body_snippet: body.slice(0, 500),\n    attachments: $input.item.json.attachments || []\n  }\n};"
      },
      "id": "extract-sender",
      "name": "Extract Sender Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
