# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# Supabase (from your project dashboard)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key – use ONLY on backend / Edge Functions, never in frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI – use ONLY on backend / Edge Functions, never in frontend
OPENAI_API_KEY=your_openai_key_here

# PlumbLine — in-house WhatsApp gateway (Maytapi-compatible drop-in).
# Read by src/services/whatsappService.js (frontend, CORS-enabled).
VITE_WA_GATEWAY_URL=https://your-gateway.up.railway.app
VITE_WA_GATEWAY_KEY=your_gateway_secret
VITE_WA_SESSION_ID=hagerstone-biz
